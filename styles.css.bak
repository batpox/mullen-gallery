:root {
  color-scheme: dark;
  --background: #10100f;
  --surface: #1a1917;
  --ink: #f3eee5;
  --muted: #bcb3a5;
  --accent: #c8a36a;
  --line: #3b3731;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  background: var(--background);
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
}

.site-header {
  max-width: 82rem;
  margin: 0 auto;
  padding: 4rem 1.25rem 2rem;
  border-bottom: 1px solid var(--line);
}

.eyebrow {
  margin: 0 0 .7rem;
  color: var(--accent);
  font: 600 .78rem/1.2 system-ui, sans-serif;
  letter-spacing: .18em;
  text-transform: uppercase;
}

h1 { margin: 0; font-size: clamp(2.6rem, 7vw, 5.6rem); font-weight: 400; line-height: .95; }
.intro { max-width: 42rem; margin: 1.3rem 0 0; color: var(--muted); font: 1rem/1.6 system-ui, sans-serif; }

.filters {
  position: sticky;
  z-index: 3;
  top: 0;
  display: flex;
  gap: .55rem;
  overflow-x: auto;
  max-width: 82rem;
  margin: 0 auto;
  padding: 1rem 1.25rem;
  background: color-mix(in srgb, var(--background) 92%, transparent);
  backdrop-filter: blur(10px);
}

.filter {
  flex: 0 0 auto;
  padding: .6rem 1rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font: 600 .82rem/1 system-ui, sans-serif;
  cursor: pointer;
}

.filter:hover, .filter.active { border-color: var(--accent); color: var(--ink); background: #2b251c; }

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1rem;
  max-width: 82rem;
  margin: 0 auto;
  padding: .5rem 1.25rem 5rem;
}

.artwork {
  position: relative;
  min-height: 18rem;
  padding: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  background: var(--surface);
  cursor: zoom-in;
}

.artwork img { display: block; width: 100%; height: 100%; min-height: 18rem; object-fit: cover; transition: transform .35s ease, opacity .35s ease; }
.artwork:hover img, .artwork:focus-visible img { transform: scale(1.025); opacity: .8; }
.artwork span { position: absolute; inset: auto 0 0; padding: 2.8rem 1rem .9rem; color: white; background: linear-gradient(transparent, rgba(0,0,0,.88)); text-align: left; font: 600 .95rem/1.2 system-ui, sans-serif; }
.artwork[hidden] { display: none; }

.lightbox {
  width: 100vw;
  max-width: none;
  height: 100vh;
  max-height: none;
  margin: 0;
  padding: .35rem;
  border: 0;
  background: rgba(7,7,7,.96);
  color: white;
}

.lightbox[open] { display: grid; place-items: center; }
.lightbox::backdrop { background: rgba(0,0,0,.9); }
.lightbox figure { display: grid; grid-template-rows: minmax(0,1fr) auto; place-items: center; width: calc(100vw - .7rem); height: calc(100vh - .7rem); margin: 0; }
.lightbox img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
.lightbox figcaption { position: fixed; bottom: .7rem; left: 50%; padding: .45rem .8rem; border-radius: .25rem; background: rgba(0,0,0,.65); color: var(--muted); font: .9rem/1.2 system-ui, sans-serif; transform: translateX(-50%); }
.close, .step { border: 0; background: transparent; color: white; cursor: pointer; }
.close { position: fixed; z-index: 2; top: .7rem; right: 1.2rem; font-size: 2.4rem; }
.step { position: fixed; z-index: 2; top: 50%; padding: 1rem; font-size: 3.5rem; color: var(--muted); transform: translateY(-50%); }
.previous { left: .5rem; }
.next { right: .5rem; }
.step:hover, .close:hover { color: var(--accent); }

@media (max-width: 620px) {
  .site-header { padding-top: 2.6rem; }
  .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
  .artwork, .artwork img { min-height: 13rem; }
  .artwork span { font-size: .78rem; }
  .lightbox { padding: .25rem; }
  .lightbox figure { width: calc(100vw - .5rem); height: calc(100vh - .5rem); }
  .step { padding: .4rem; font-size: 2.5rem; }
}
