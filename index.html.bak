<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A collection of paintings and portraits by Mullen.">
  <title>Mullen Gallery</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <p class="eyebrow">Artist collection</p>
    <h1>Mullen Gallery</h1>
    <p class="intro">Select a category, then choose an image to view the full-sized work.</p>
  </header>

  <nav class="filters" aria-label="Gallery categories">
    <button class="filter active" type="button" data-filter="all" aria-pressed="true">All works</button>
    <button class="filter" type="button" data-filter="people" aria-pressed="false">People</button>
    <button class="filter" type="button" data-filter="places" aria-pressed="false">Places</button>
    <button class="filter" type="button" data-filter="nature" aria-pressed="false">Nature</button>
    <button class="filter" type="button" data-filter="abstract" aria-pressed="false">Abstract</button>
  </nav>

  <main>
    <section id="gallery" class="gallery" aria-label="Artwork"></section>
  </main>

  <dialog id="lightbox" class="lightbox" aria-label="Full-size artwork">
    <button id="close" class="close" type="button" aria-label="Close full-size view">×</button>
    <button id="previous" class="step previous" type="button" aria-label="Previous artwork">‹</button>
    <figure>
      <img id="lightbox-image" alt="">
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
    <button id="next" class="step next" type="button" aria-label="Next artwork">›</button>
  </dialog>

  <script src="gallery.js"></script>
</body>
</html>
